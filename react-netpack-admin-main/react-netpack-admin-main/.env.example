# ==============================================================================
# NETPACK LOGISTICS - FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Location: react-netpack-admin-main/react-netpack-admin-main/.env.example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API URL
# ------------------------------------------------------------------------------
# When deployed together on Railway (Single Platform):
# Leave empty OR set to "/api" (the frontend automatically uses same-origin /api).
# VITE_API_URL=

# When deployed separately (e.g. Frontend on Vercel and Backend on Railway):
# Set to your full Railway backend API endpoint:
# VITE_API_URL=https://your-backend.up.railway.app/api

# For local development with Vite dev server (port 5173 -> proxy to 8000):
# VITE_API_URL=http://localhost:8000/api
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH CLIENT ID (For Customer 1-Click Login)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. APP BRANDING
# ------------------------------------------------------------------------------
VITE_APP_TITLE="NetPack Logistics"
VITE_COMPANY_NAME="NetPack Logistics Pvt. Ltd."
