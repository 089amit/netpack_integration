# ==============================================================================
# NETPACK LOGISTIC - UNIFIED ENVIRONMENT TEMPLATE (.env.example)
# Deploying on Railway (Single Platform):
# Copy these values into Railway Dashboard -> Project -> Variables
# ==============================================================================

# 1. SERVER CONFIGURATION
PORT=8000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=https://your-app.up.railway.app

# 2. DATABASE CONFIGURATION
# SQLite (Local):
DATABASE_URL=sqlite:///./netpack.db
# PostgreSQL (Railway Plugin):
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway

# 3. JWT AUTHENTICATION SECRETS
JWT_SECRET=netpack_customer_jwt_secret_key_change_in_production_2026
JWT_ADMIN_SECRET=netpack_admin_staff_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. SMTP EMAIL SETTINGS (Zoho Mail Organization - noreply@netpacklogistic.com)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=noreply@netpacklogistic.com
SMTP_PASSWORD=your_zoho_application_specific_password_here
SMTP_FROM_EMAIL=noreply@netpacklogistic.com
SMTP_FROM_NAME="NetPack Logistic"
SMTP_REPLY_TO="info@netpacklogistic.com"
SMTP_USE_TLS=False
SMTP_USE_SSL=True

# 5. THIRD-PARTY LOGISTICS API (TrackingMore)
TRACKINGMORE_API_KEY=
TRACKINGMORE_WEBHOOK_SECRET=

# 6. FILE STORAGE
UPLOADS_DIR=uploads
