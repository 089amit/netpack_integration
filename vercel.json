{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tasks",
      "destination": "/enquiries",
      "permanent": true
    },
    {
      "source": "/tasks/(.*)",
      "destination": "/enquiries",
      "permanent": true
    }
  ],
  "services": {
    "react-netpack-admin-main": {
      "root": "react-netpack-admin-main/react-netpack-admin-main",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "netpack-backend-python": {
      "root": "netpack-backend-python",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "netpack-backend-python"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "netpack-backend-python"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "react-netpack-admin-main"
      }
    }
  ]
}
