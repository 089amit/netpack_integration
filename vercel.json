{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "react-netpack-admin-main": {
      "root": "react-netpack-admin-main/react-netpack-admin-main",
      "framework": "vite"
    },
    "netpack-backend-python": {
      "root": "netpack-backend-python",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "netpack-backend-python",
        "path": "/api/:path*"
      }
    },
    {
      "source": "/assets/:path*",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/assets/:path*"
      }
    },
    {
      "source": "/download/:path*",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/download/:path*"
      }
    },
    {
      "source": "/images/:path*",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/images/:path*"
      }
    },
    {
      "source": "/:file([^/]+\\.[^/]+)",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/:file"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/index.html"
      }
    }
  ]
}
