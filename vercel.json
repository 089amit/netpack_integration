{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "react-netpack-admin-main": {
      "root": "react-netpack-admin-main/react-netpack-admin-main",
      "framework": "vite"
    },
    "netpack-backend-python": {
      "root": "netpack-backend-python",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "netpack-backend-python"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/download/(.*)",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/download/$1"
      }
    },
    {
      "source": "/images/(.*)",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/images/$1"
      }
    },
    {
      "source": "/(.*\\.(?:ico|png|svg|json|webmanifest|js|css|apk|txt|xml))",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "react-netpack-admin-main",
        "path": "/index.html"
      }
    }
  ]
}
