{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "react-netpack-admin-main": {
      "root": "react-netpack-admin-main/react-netpack-admin-main",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "netpack-backend-python": {
      "root": "netpack-backend-python",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "netpack-backend-python"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "netpack-backend-python"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "react-netpack-admin-main"
      }
    }
  ]
}
