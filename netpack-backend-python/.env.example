# ==============================================================================
# NETPACK LOGISTICS - BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and configure the variables for your environment.
# When deploying to Railway, add these key-value pairs in Railway Dashboard -> Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Port for FastAPI server (Railway automatically sets PORT, defaults to 8000 locally)
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

# Frontend Base URL (Used for generating 1-click tracking links in emails)
# When deploying on Railway unified container: Use your Railway app URL, e.g. https://your-app.up.railway.app
# When running locally: http://localhost:8000 (or http://localhost:5173 for Vite dev)
FRONTEND_URL=https://your-netpack-app.up.railway.app

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (SQLite - zero configuration):
# DATABASE_URL=sqlite:///./netpack.db

# Production Deployment (PostgreSQL on Railway):
# If you add a PostgreSQL plugin on Railway, Railway provides ${{Postgres.DATABASE_URL}} automatically.
# Example format: postgresql://postgres:your_db_password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=sqlite:///./netpack.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Generate strong, random secrets in production (e.g. using openssl rand -hex 32)
JWT_SECRET=netpack_customer_portal_jwt_secret_key_change_in_production_2026
JWT_ADMIN_SECRET=netpack_admin_staff_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL CONFIGURATION (Automatic Booking Confirmations & Receiver Copies)
# ------------------------------------------------------------------------------
# Supported SMTP services: Gmail, Google Workspace, Brevo, SendGrid, Amazon SES, Outlook, Zoho, etc.
# Note: If these are left blank, the system will log emails to the console instead of failing.

# For Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=info@netpacklogistic.com
#   SMTP_PASSWORD=your_16_character_app_specific_password
#   SMTP_USE_TLS=True
#   SMTP_USE_SSL=False

# For Brevo (Sendinblue):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your_brevo_smtp_login
#   SMTP_PASSWORD=your_brevo_smtp_key

# For SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=your_sendgrid_api_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@netpacklogistic.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM_EMAIL=info@netpacklogistic.com
SMTP_FROM_NAME="NetPack Logistics"
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# ------------------------------------------------------------------------------
# 5. EXTERNAL CARRIER INTEGRATIONS (TrackingMore API)
# ------------------------------------------------------------------------------
# Used for real-time tracking across 1200+ couriers and air cargo airlines (MAWB)
TRACKINGMORE_API_KEY=your_trackingmore_api_key_here
TRACKINGMORE_WEBHOOK_SECRET=your_trackingmore_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. STORAGE & MEDIA UPLOADS
# ------------------------------------------------------------------------------
# Relative or absolute path where rider proof photos, customer avatars, and manifests are saved
UPLOADS_DIR=uploads
